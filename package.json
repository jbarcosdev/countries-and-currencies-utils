{
  "name": "countries-and-currencies-utils",
  "version": "0.3.1",
  "description": "Countries and currencies utils",
  "author": {
    "name": "Jose Barcos",
    "email": "jose@openloops.xyz",
    "url": "https://github.com/jbarcosdev"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:update": "yarn data:fetch && yarn data:build",
    "build": "yarn data:build && tsup src/index.ts --format cjs,esm --minify && tsc --emitDeclarationOnly",
    "test": "yarn build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "yarn test",
    "check-size": "npm pack --dry-run",
    "release": "npm version patch && npm publish --access public"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "keywords": [
    "country",
    "currency",
    "utils",
    "countries",
    "currencies",
    "money",
    "currency utilities",
    "typescript",
    "library",
    "nodejs",
    "browser",
    "deno"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbarcosdev/countries-and-currencies-utils.git"
  }
}
